# Copie este arquivo para ".env" antes de rodar o servidor.

# Porta em que a API vai escutar
PORTA=3000

# Segredo usado para assinar os tokens JWT — troque por um valor aleatório
# antes de qualquer ambiente real (nunca reaproveite o valor de exemplo).
JWT_SEGREDO=troque-isto-antes-de-ir-para-producao

# Por quanto tempo o token de login continua válido
JWT_EXPIRACAO=7d
