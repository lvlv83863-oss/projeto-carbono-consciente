      "proxima": "ཤུལ་མམ་གི་ཁྱད་དུ་འཕགས་པའི་གནས་ཚུལ",
      "erro_carregar": "ད་ལྟོ་ཁྱད་དུ་འཕགས་པའི་གནས་ཚུལ་འདྲེན་མ་ཚུགས།",
      "fatos": {
        "fato1": "ཤིང་རྒས་ཅིག་གིས་ལོ་རེ་ལུ་ཆ་སྙོམས་སུ་CO₂ཀི་ཀི་ལོ་ 22 ཙམ་བདག་འཛིན་འབད་དོ། དེ་འབད་ནི་འདི་ལས་ནགས་ཚལ་བསྐྱར་འཛུགས་འདི་ཐོན་ཚད་ཉུང་བཅུག་ནིའི་ཐབས་ལམ་ལེགས་ཤོས་ཅིག་ཨིན།",
        "fato2": "རྒྱ་མཚོ་ཚུ་གིས་ལོ་རེ་ལུ་མི་ཚུ་གིས་ཐོན་པའི་CO₂ཀུན་གྱི་བཞི་ཚན་གཅིག་ཙམ་བདག་འཛིན་འབད་ཞིནམ་ལས་ འཛམ་གླིང་གི་གནམ་གཤིས་དཀའངས་ཤོས་ཅིག་སྦེ་ལཱ་འབད་དོ།",
        "fato3": "ཤོག་ཁྲམ་ཊཱོན་གཅིག་བསྐྱར་སྤྱོད་འབད་བའི་སྐབས་ཤིང་ 17 ཙམ་དང་ཆུ་དང་ཤུགས་ཆ་མང་རབས་ཅིག་ཤོག་ཁྲམ་གསརཔ་བཟོ་ནི་ལས་ཉུང་སུ་སྲུང་ཐོག་ཨིན།",
        "fato4": "འགྲུལ་འཐབ་འདི་ཤུགས་ཆ་དང་འབྲེལ་བའི་འཛམ་གླིང་གི་CO₂ཐོན་ཚད་གྱི་བཞི་ཚན་གཅིག་གི་འགན་འཁྲི་ཨིན། ལམ་ཐུང་ཀུ་ནང་མོ་ཊར་དང་ ཀེང་རིམ་ཡང་ན་མི་སྡེའི་འགྲུལ་འཐབ་ལུ་སོར་བའི་དུས་ཁྱད་པར་ངོ་མ་ཐོན་དོ།",
        "fato5": "ཨཱ་མ་ཛཱོན་ནང་ འཛམ་གླིང་གི་ངོ་ཤེས་སྐྱེ་དངོས་སྣ་ཚོགས་ཀུན་གྱི་ 10% ཙམ་ཡོད་ཅིང་ ཤིང་ནགས་ནང་ལུ་ཀར་བཱོན་ཊཱོན་ བྱེ་བ་ཁྱད་ཀྱིས་མཛོད་དོ།",
        "fato6": "ཁྱིམ་གྱི་ནི་མའི་ཤུགས་ཆ་འཛིན་ཆས་ཚུ་གིས་ ཁྱིམ་གི་ཀར་བཱོན་ཁུར་དེ་ལོ་རེ་ལུ་CO₂ཊཱོན་ཁྱད་ཀྱིས་ཉུང་སུ་བཏང་ཚུགས། འདི་ཉི་ཁའི་ཤུགས་ཆའི་དབྱེ་བ་ལུ་རག་ལས་དོ།",
        "fato7": "ཤ་དམར་ཉུང་སུའི་ཟས་སྟོན་འདི་གིས་སྒེར་གྱི་ཀར་བཱོན་ཁུར་དེ་ཁྱད་ཀྱིས་ཉུང་སུ་བཏང་ཚུགས། ནོར་གསོད་འདི་ཐོན་ཚད་མང་ཤོས་ཅིག་གི་སོ་ནམ་ལཱ་ཅིག་ཨིན།",
        "fato8": "ཨར་ཀི་ཊིཀ་གྱི་རྒྱ་མཚོའི་གངས་ཞུ་ནི་འདི་གིས་ འཛམ་གླིང་གིས་ཉི་འོད་ནམ་མཁའ་ལུ་སླར་གསལ་འབད་ནིའི་ནུས་པ་ཉུང་སུ་བཏང་ཞིནམ་ལས་ དྲོད་འཕེལ་མགྱོགས་སུ་བཏང་དོ། འདི་ལུ་ཨལ་བི་ཌོ་ལོག་སླར་ཟེར་མི་ཅིག་སླབ་ཨིན།",
        "fato9": "LED མར་མེ་ཚུ་གིས་སྔར་སྲོལ་མར་མེ་ལས་ཤུགས་ཆ་ 80% ཉུང་སུ་སྤྱོད་ཞིནམ་ལས་ ཡུན་ཐུང་མ་ཚུགས་སྦེ་ལོངམ་སྦེ་ལཱ་འབད་ཚུགས། དེ་འབད་ནི་འདི་གིས་ཐོན་ཚད་དང་སྣུམ་ཁག་ཉུང་སུ་བཏང་དོ།",
        "fato10": "རྒྱལ་ཁབ་ 200 ཙམ་གིས་མོ་མཐུན་འབད་མི་པ་རི་སི་ཆིངས་ཡིག་འདི་གིས་ འཛམ་གླིང་གི་དྲོད་འཕེལ་དེ་ལཱ་རིམ་མང་འཐབ་ཧེ་མའི་ཚད་ལས་ 2°C ལས་ལྷག་སྟེ་ཉུང་སུ་བཞག་ནིའི་དམིགས་དོན་ཨིན།",
        "fato11": "འཛམ་གླིང་ནང་ཐོན་པའི་ཟས་ཀུན་གྱི་ 1/3 ཙམ་སྟོར་ཞོར་དོ། ཟས་སྟོར་ཆ་འདི་རྐྱངམ་གཅིག་གིས་ འཛམ་གླིང་གི་ཚ་དྲོད་རླུང་གཟུགས་ཐོན་ཚད་གྱི་ཡན་ལག་ཁྱད་ཀྱིས་ཅིག་ཐོན་དོ།",
        "fato12": "དེང་སངས་ཀྱི་རླུང་འཁོར་ཚུ་གིས་ ཁྱིམ་སྟོང་ཕྲག་ལུ་ཤུགས་ཆ་འཐོབ་ནིའི་ཤུགས་ཆ་ལངམ་ཅིག་བཟོ་ཚུགས། ལཱ་འབད་པའི་སྐབས་CO₂མེད།",
        "fato13": "ས་ཁམས་འཚོ་དང་ལྡན་པ་འདི་གིས་ཤིང་ནགས་དང་ནམ་མཁའི་དབུགས་ཀུན་བསྡོམས་ལས་ཀར་བཱོན་ཁྱད་ཀྱིས་མང་སུ་མཛོད་དོ། སོ་ནམ་གྱི་ལམ་ལུགས་ལེགས་ཤོམ་འདི་གིས་ཀར་བཱོན་དེ་ས་ནང་བཞག་ནི་ལུ་ཕན་ཐོག་ཨིན།",
        "fato14": "མཚོ་ནང་གི་ཀོ་རལ་ཚུ་གིས་རྒྱ་མཚོའི་གཞི་ 1% ལས་ཉུང་སུ་ཁེབས་རུང་ མཚོ་ནང་གི་སྲོག་ཆགས་ངོ་ཤེས་ཀུན་གྱི་ 25% ཙམ་རྒྱབ་སྐྱོར་འབད་དོ། འདི་ཚུ་ཆུའི་དྲོད་འཕེལ་ལུ་ཤིན་ཏུ་དཀའངས་ཅན་ཨིན།",
        "fato15": "ཁྱིམ་ནང་ཆུ་དྲོད་སྟོར་ཆ་ཉུང་སུ་བཏང་ནི་ (དཔེར་ན་ཁྲུས་ཐུང་སུ) འདི་གིས་ཡང་ཐོན་ཚད་ཉུང་སུ་བཏང་དོ། ཆུ་དྲོན་མོ་བཟོ་ནི་ལུ་ཤུགས་ཆ་དགོས་ཨིན།",
        "fato16": "གློག་མོ་ཊར་ཚུ་གིས་ བེཊ་རི་བཟོ་ནི་ཚད་ཡང་བརྩི་རུང་ མེད་སྣུམ་མོ་ཊར་ལས་ཚེ་ཚད་ཧྲིལ་བུ་ནང་CO₂ཉུང་སུ་ཐོན་དོ། ལྷག་པར་དུ་གློག་མེ་དེ་གཙང་མའི་འབྱུང་ཁུངས་ལས་ཐོན་པ་ཅིན།",
        "fato17": "ཁྱིམ་ནང་ཤིང་ཟས་སྟོར་ཆ་ལུད་བཟོ་ནི་འདི་གིས་ ལུད་ཁང་ནང་མི་ཋེན་རླུང་གཟུགས་ཐོན་ནི་ལས་སྲུང་ཐོག་ཨིན། འདི་ནི་ཡུན་ཐུང་ནང་CO₂ལས་ཤུགས་ཆེ་བའི་ཚ་དྲོད་རླུང་གཟུགས་ཨིན།",
        "fato18": "གིརིན་ལེནཌ་དང་ཨེན་ཊར་ཀི་ཊི་ཀའི་གངས་རི་ཚུ་གིས་ ད་ལྟོའི་ལོ་ངོ་ཚུ་ནང་ལོ་རེ་ལུ་གངས་ཊཱོན་བྱེ་བ་ བརྒྱ་ཁྱད་ཀྱིས་བརླག་སྟོར་དོ། འདི་གིས་རྒྱ་མཚོའི་མཐོ་ཚད་མཐོ་ནི་ལུ་ཤུགས་རྐྱང་ཕན་ཐོག་དོ།"
